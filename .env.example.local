# ── Base de datos (Desarrollo Local) ─────────────────────────────────────────
# PostgreSQL local para desarrollo (requiere PostgreSQL instalado localmente)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tienda_ropas_dev"

# Alternativa: Usar una base de datos PostgreSQL en la nube para desarrollo
# Puedes usar servicios gratuitos como:
# - Neon (https://neon.tech)
# - Supabase (https://supabase.com)
# - Railway PostgreSQL

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Seguridad ─────────────────────────────────────────────────────────────────
# JWT_SECRET=cambiar_por_clave_segura_aleatoria