# ── Base de datos ─────────────────────────────────────────────────────────────
# PostgreSQL (producción Railway) — Railway genera automáticamente DATABASE_URL
# Formato: postgresql://usuario:password@host:5432/database
DATABASE_URL="postgresql://usuario:password@host:5432/tienda_ropas"

# SQLite local (desarrollo opcional)
# DATABASE_URL="file:./prisma/dev.db"

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Seguridad ─────────────────────────────────────────────────────────────────
# JWT_SECRET=cambiar_por_clave_segura_aleatoria
